{
  "expo": {
    "name": "AdBrain",
    "slug": "adbrain",
    "version": "0.2.0",
    "orientation": "portrait",
    "scheme": "adbrain",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "android": {
      "package": "com.probuilderoffical.adbrain",
      "versionCode": 2
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}